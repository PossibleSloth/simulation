[numthreads(8,8,1)]
void Render (uint3 id : SV_DispatchThreadID)
{
    if (id.x >= (uint)_Width || id.y >= (uint)_Height) return;

    int2 p = int2(id.xy);
    float2 v = _FieldCurr[p];

    float magnitude = length(v);           // |psi| analog / amplitude
    float phase = atan2(v.y, v.x);         // useful once this is complex

    // Simple amplitude -> intensity, phase -> hue (HSV->RGB)
    float hue = (phase + 3.14159265) / (2.0 * 3.14159265);
    float sat = 1.0;
    float val = saturate(magnitude);

    float3 rgb;
    float hh = hue * 6.0;
    int i = (int)hh;
    float f = hh - i;
    float pV = val * (1.0 - sat);
    float qV = val * (1.0 - sat * f);
    float tV = val * (1.0 - sat * (1.0 - f));

    if (i == 0) rgb = float3(val, tV, pV);
    else if (i == 1) rgb = float3(qV, val, pV);
    else if (i == 2) rgb = float3(pV, val, tV);
    else if (i == 3) rgb = float3(pV, qV, val);
    else if (i == 4) rgb = float3(tV, pV, val);
    else rgb = float3(val, pV, qV);

    _DisplayTex[p] = float4(rgb, 1.0);
}



